# AI Vision Service Config
ENV=development
PORT=8000

# Node.js core backend callback URL
CORE_BACKEND_URL=http://localhost:5000

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=anti-fraud-proofs

# YOLOv8 Model path (leave blank to use pretrained YOLOv8n)
YOLO_MODEL_PATH=

# Confidence threshold for YOLO object detection (0-1)
YOLO_CONFIDENCE=0.50
